# Copie para .env.local nesta pasta. Nunca compartilhe o arquivo preenchido.
# production liga as vendas pelo Mercado Pago; disabled deixa a loja sem pagamento (pedidos recusados).
MAEVI_MP_MODE=disabled
MAEVI_MP_ACCESS_TOKEN=
MAEVI_MP_WEBHOOK_SECRET=
# Origem HTTPS sem caminho. Não use localhost, IP ou URL do painel administrativo.
MAEVI_PUBLIC_URL=

# OPCIONAL: IA para rascunhos de produtos no painel (chave apenas no servidor).
# Requer conta de API com faturamento próprio; assinatura ChatGPT não fornece créditos de API.
# MAEVI_OPENAI_API_KEY=
# MAEVI_OPENAI_MODEL=gpt-4.1-mini
